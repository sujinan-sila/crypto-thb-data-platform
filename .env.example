# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Binance symbols to stream
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT

# Bank of Thailand API tokens (portal.api.bot.or.th, "Token" field, not "Token Hash")
BOT_TOKEN_FX=your-exchange-rates-token
BOT_TOKEN_HOLIDAYS=your-holidays-token

# Event Hubs send connection string (terraform output -raw eh_send_connection)
# Leave commented to send to the local Kafka in docker-compose instead
# EH_CONNECTION_STRING=Endpoint=sb://ehns-xxx.servicebus.windows.net/;SharedAccessKeyName=producer-send;SharedAccessKey=...;EntityPath=trades
